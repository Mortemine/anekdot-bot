# HTTP server
HTTP_ADDR=:8080

# PostgreSQL
DATABASE_URL=postgres://anekdot:anekdot@localhost:5432/anekdot?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

# Admin API. Leave empty to disable /api/v1/admin/*.
# Must be at least 16 characters when set.
ADMIN_TOKEN=

# Comma separated list of allowed browser origins, or "*" for any.
CORS_ORIGINS=http://localhost:5173

# Set to true only behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Directory with the built SPA. Leave empty to serve the API only.
WEB_DIR=web

# Directory with categories.txt and anek_data.txt.
DATA_DIR=../data

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# External anecdote provider
EXTERNAL_ANEKDOT_URL=https://baneks.site/random
REQUEST_TIMEOUT=10s

# Graceful shutdown budget
SHUTDOWN_TIMEOUT=15s
